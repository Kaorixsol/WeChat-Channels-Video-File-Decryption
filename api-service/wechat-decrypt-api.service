[Unit]
Description=WeChat Video Decryption API Service
Documentation=https://github.com/Evil0ctal/WeChat-Channels-Video-File-Decryption
After=docker.service network.target
Requires=docker.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
WorkingDirectory=/opt/wechat-decrypt-api/app

# 环境变量
Environment=NODE_ENV=production
Environment=PORT=8010
Environment=CONTAINER_NAME=wechat-decrypt-api
Environment=DOCKER_IMAGE=wechat-decrypt-api:playwright

# 启动命令
ExecStartPre=-/usr/bin/docker stop ${CONTAINER_NAME}
ExecStartPre=-/usr/bin/docker rm ${CONTAINER_NAME}
ExecStart=/usr/bin/docker run -d \
    --name ${CONTAINER_NAME} \
    --restart unless-stopped \
    -p 8010:8010 \
    -e NODE_ENV=production \
    -e PORT=8010 \
    --shm-size=2gb \
    --security-opt no-new-privileges:true \
    --memory=2g \
    --cpus=2 \
    --log-driver=json-file \
    --log-opt max-size=100m \
    --log-opt max-file=3 \
    -v /var/log/wechat-decrypt-api:/app/logs \
    ${DOCKER_IMAGE}

# 停止命令
ExecStop=/usr/bin/docker stop ${CONTAINER_NAME}
ExecStopPost=/usr/bin/docker rm ${CONTAINER_NAME}

# 重启策略
Restart=on-failure
RestartSec=10

# 安全设置
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/wechat-decrypt-api

# 超时设置
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target